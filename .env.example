# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
ENV=dev                       # dev | staging | production
LOG_LEVEL=INFO
LOG_JSON=true

# ---------------------------------------------------------------------------
# Infrastructure
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://office:office@localhost:5432/office
REDIS_URL=redis://localhost:6379/0
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Used by docker-compose.prod.yml
POSTGRES_USER=office
POSTGRES_PASSWORD=change-me
POSTGRES_DB=office
DOMAIN=localhost
PUBLIC_API_URL=http://localhost:8000
WORKER_REPLICAS=2

# ---------------------------------------------------------------------------
# Secrets — REQUIRED. The service refuses to start in production without them.
# ---------------------------------------------------------------------------
# Key-encryption keys for stored provider credentials.
#   Generate: python -m scripts.rotate_keys --generate
# Single key (treated as version "1"):
MASTER_KEYS=CHANGE_ME_BASE64_32_BYTES
# During rotation, use the JSON form and keep the old key until re-wrapping is done:
#   MASTER_KEYS={"1":"<old base64>","2":"<new base64>"}
#   MASTER_KEY_VERSION=2
MASTER_KEY_VERSION=1

# Signing key for access tokens. 32+ characters.
#   Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_AT_LEAST_32_CHARACTERS_LONG
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_MIN_LENGTH=12

# ---------------------------------------------------------------------------
# Provider credentials (platform-owned; used in `managed` and `hybrid` modes).
# Leave one blank and its models are only available to orgs that supply a key.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=

# ---------------------------------------------------------------------------
# Run limits — the platform ceiling. A workflow may ask for less, never more.
# ---------------------------------------------------------------------------
MAX_STEPS_PER_RUN=40
MAX_COST_CENTS_PER_RUN=500
STEP_TIMEOUT_SECONDS=600
RUN_TIMEOUT_SECONDS=3600
MAX_BOARD_CHARS=400000

# ---------------------------------------------------------------------------
# Billing
# ---------------------------------------------------------------------------
BILLING_ENABLED=true
CREDIT_MARKUP_PERCENT=40
SIGNUP_BONUS_CENTS=100

# ---------------------------------------------------------------------------
# Rate limits (per organisation unless noted)
# ---------------------------------------------------------------------------
RATE_LIMIT_RUNS_PER_MINUTE=20
RATE_LIMIT_API_PER_MINUTE=300
MAX_CONCURRENT_RUNS_PER_ORG=5

# ---------------------------------------------------------------------------
# HTTP
# ---------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000
TRUSTED_HOSTS=*
MAX_REQUEST_BYTES=2097152
