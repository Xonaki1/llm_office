# Where the browser sends API calls. Keep it same-origin so the httpOnly
# refresh cookie is sent — the Next rewrite (dev) and Caddy (production) both
# proxy /api to the backend.
NEXT_PUBLIC_API_URL=/api

# Where the Next dev-server rewrite forwards /api. Not used in production,
# where Caddy does the proxying.
API_ORIGIN=http://localhost:8000
